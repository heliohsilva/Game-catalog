# Game Catalog Environment Configuration

# Frontend
PORT=3000
NEXT_PUBLIC_APP_NAME="Game Catalog"
# Relative path '/api/v1' ensures browser requests hit the current host and Next.js proxy
NEXT_PUBLIC_API_URL="/api/v1"
INTERNAL_API_URL="http://api:8080/api/v1"

# Backend API (Golang with Gin)
API_PORT=8080
GIN_MODE=release

# Database (SQLite)
DB_PATH="data/game_catalog.sqlite"
AUTO_SEED=false

# Security & CORS (Server-side proxy bypasses CORS; allows localhost for direct tooling)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,*"
